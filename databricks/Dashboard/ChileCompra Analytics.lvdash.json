{
  "datasets": [
    {
      "name": "ab7bd5c6",
      "displayName": "compras_mensuales",
      "queryLines": [
        "SELECT\n",
        "    make_date(anio, mes, 1) AS periodo,\n",
        "    cantidad_ordenes,\n",
        "    monto_total_ordenes_clp,\n",
        "    monto_promedio_orden_clp,\n",
        "    organismos_distintos,\n",
        "    proveedores_distintos\n",
        "FROM chilecompra.gold.compras_mensuales\n",
        "ORDER BY periodo"
      ]
    },
    {
      "name": "d744b73c",
      "displayName": "kpis_generales",
      "queryLines": [
        "SELECT\n",
        "    make_date(\n",
        "        year(fecha_envio),\n",
        "        month(fecha_envio),\n",
        "        1\n",
        "    ) AS periodo,\n",
        "\n",
        "    codigo,\n",
        "    monto_total_clp,\n",
        "    codigo_proveedor,\n",
        "    codigo_organismo_publico\n",
        "\n",
        "FROM chilecompra.silver.ordenes_compra\n",
        "\n",
        "WHERE fecha_envio IS NOT NULL\n",
        "  AND monto_total_clp IS NOT NULL\n",
        "  AND codigo_estado <> 9"
      ]
    },
    {
      "name": "6f52e887",
      "displayName": "top 10 organismos",
      "queryLines": [
        "SELECT\n",
        "    make_date(anio, mes, 1) AS periodo,\n",
        "    organismo_publico,\n",
        "    monto_total_ordenes_clp\n",
        "FROM chilecompra.gold.ordenes_por_organismo_mensual"
      ]
    },
    {
      "name": "c461cb30",
      "displayName": "Top 10 proveedores",
      "queryLines": [
        "SELECT\n",
        "    make_date(anio, mes, 1) AS periodo,\n",
        "    date_format(make_date(anio, mes, 1), 'yyyy-MM') AS periodo_mes,\n",
        "    nombre_proveedor,\n",
        "    monto_total_ordenes_clp\n",
        "FROM chilecompra.gold.ordenes_por_proveedor_mensual"
      ]
    },
    {
      "name": "6ffb67eb",
      "displayName": "Licitaciones por estado",
      "queryLines": [
        "SELECT\n",
        "    make_date(anio, mes, 1) AS periodo,\n",
        "    date_format(make_date(anio, mes, 1), 'yyyy-MM') AS periodo_mes,\n",
        "\n",
        "    CASE codigo_estado\n",
        "        WHEN 5 THEN 'Publicada'\n",
        "        WHEN 6 THEN 'Cerrada'\n",
        "        WHEN 7 THEN 'Desierta'\n",
        "        WHEN 8 THEN 'Adjudicada'\n",
        "        WHEN 15 THEN 'Revocada'\n",
        "        WHEN 16 THEN 'Suspendida'\n",
        "        ELSE CONCAT('Estado ', codigo_estado)\n",
        "    END AS estado,\n",
        "\n",
        "    cantidad_licitaciones\n",
        "\n",
        "FROM chilecompra.gold.licitaciones_por_mes_cierre_estado"
      ]
    },
    {
      "name": "bf39e372",
      "displayName": "kpis_licitaciones",
      "queryLines": [
        "SELECT\n",
        "    make_date(anio, mes, 1) AS periodo,\n",
        "    date_format(make_date(anio, mes, 1), 'yyyy-MM') AS periodo_mes,\n",
        "\n",
        "    SUM(cantidad_licitaciones) AS total_licitaciones,\n",
        "\n",
        "    SUM(\n",
        "        CASE WHEN codigo_estado = 8\n",
        "        THEN cantidad_licitaciones ELSE 0 END\n",
        "    ) AS adjudicadas,\n",
        "\n",
        "    SUM(\n",
        "        CASE WHEN codigo_estado = 5\n",
        "        THEN cantidad_licitaciones ELSE 0 END\n",
        "    ) AS publicadas,\n",
        "\n",
        "    SUM(\n",
        "        CASE WHEN codigo_estado = 7\n",
        "        THEN cantidad_licitaciones ELSE 0 END\n",
        "    ) AS desiertas\n",
        "\n",
        "FROM chilecompra.gold.licitaciones_por_mes_cierre_estado\n",
        "\n",
        "GROUP BY anio, mes\n",
        "\n",
        "ORDER BY periodo"
      ]
    },
    {
      "name": "15fa1e6e",
      "displayName": "Evolución mensual de licitaciones por fecha de cierre",
      "queryLines": [
        "SELECT\n",
        "    make_date(anio, mes, 1) AS periodo,\n",
        "    date_format(make_date(anio, mes, 1), 'yyyy-MM') AS periodo_mes,\n",
        "    SUM(cantidad_licitaciones) AS cantidad_licitaciones\n",
        "\n",
        "FROM chilecompra.gold.licitaciones_por_mes_cierre_estado\n",
        "\n",
        "GROUP BY anio, mes\n",
        "\n",
        "ORDER BY periodo"
      ]
    },
    {
      "name": "d286950c",
      "displayName": "Evolución mensual por estado",
      "queryLines": [
        "SELECT\n",
        "    make_date(anio, mes, 1) AS periodo,\n",
        "    date_format(make_date(anio, mes, 1), 'yyyy-MM') AS periodo_mes,\n",
        "\n",
        "    CASE codigo_estado\n",
        "        WHEN 5 THEN 'Publicada'\n",
        "        WHEN 6 THEN 'Cerrada'\n",
        "        WHEN 7 THEN 'Desierta'\n",
        "        WHEN 8 THEN 'Adjudicada'\n",
        "        WHEN 15 THEN 'Revocada'\n",
        "        WHEN 16 THEN 'Suspendida'\n",
        "        ELSE CONCAT('Estado ', codigo_estado)\n",
        "    END AS estado,\n",
        "\n",
        "    cantidad_licitaciones\n",
        "\n",
        "FROM chilecompra.gold.licitaciones_por_mes_cierre_estado\n",
        "\n",
        "ORDER BY periodo"
      ]
    },
    {
      "name": "f6f4ad98",
      "displayName": "Relacion con ordenes de compras",
      "queryLines": [
        "SELECT\n",
        "    make_date(anio, mes, 1) AS periodo,\n",
        "    date_format(make_date(anio, mes, 1), 'yyyy-MM') AS periodo_mes,\n",
        "    total_ordenes,\n",
        "    ordenes_con_licitacion,\n",
        "    ordenes_sin_licitacion,\n",
        "    ordenes_con_match_api,\n",
        "    porcentaje_con_licitacion\n",
        "\n",
        "FROM chilecompra.gold.oc_licitaciones_mensual\n",
        "\n",
        "ORDER BY periodo"
      ]
    },
    {
      "name": "628943e0",
      "displayName": "Top Suppliers by Order Amount in Chile 2023",
      "queryLines": [
        "SELECT\n",
        "    nombre_proveedor,\n",
        "    SUM(monto_total_ordenes_clp) AS monto_total_ordenes_clp\n",
        "FROM chilecompra.gold.ordenes_por_proveedor_mensual\n",
        "WHERE\n",
        "    array_contains(\n",
        "        :periodo_filtro,\n",
        "        date_format(make_date(anio, mes, 1), 'yyyy-MM')\n",
        "    )\n",
        "    OR :periodo_filtro IS NULL\n",
        "GROUP BY nombre_proveedor\n",
        "ORDER BY monto_total_ordenes_clp DESC\n",
        "LIMIT 10"
      ],
      "parameters": [
        {
          "displayName": "periodo_filtro",
          "keyword": "periodo_filtro",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "operator": {
              "operator": "AND"
            }
          }
        }
      ]
    }
  ],
