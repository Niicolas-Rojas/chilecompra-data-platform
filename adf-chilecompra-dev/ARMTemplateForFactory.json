{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-chilecompra-dev"
		},
		"ls_adls_chilecompra_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stchilecompradev.dfs.core.windows.net/"
		},
		"ls_rest_mercado_publico_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://api.mercadopublico.cl/servicios/v1/publico/"
		},
		"trigger_chilecompra_properties_pl_chilecompra_incremental_parameters_process_date": {
			"type": "string",
			"defaultValue": "@formatDateTime(addDays(convertFromUtc(trigger().scheduledTime,'Pacific SA Standard Time'),-1),'yyyy-MM-dd')"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_chilecompra_historial')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "gm_check_historical_file",
						"type": "GetMetadata",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "ds_oc_historical_csv",
								"type": "DatasetReference",
								"parameters": {
									"year": {
										"value": "@pipeline().parameters.year",
										"type": "Expression"
									},
									"month": {
										"value": "@pipeline().parameters.month",
										"type": "Expression"
									},
									"file_name": {
										"value": "@pipeline().parameters.file_name",
										"type": "Expression"
									}
								}
							},
							"fieldList": [
								"exists",
								"size",
								"lastModified"
							],
							"storeSettings": {
								"type": "AzureBlobFSReadSettings",
								"recursive": true,
								"enablePartitionDiscovery": false
							},
							"formatSettings": {
								"type": "DelimitedTextReadSettings"
							}
						}
					},
					{
						"name": "if_historical_file_exists",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "gm_check_historical_file",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@activity('gm_check_historical_file').output.exists",
								"type": "Expression"
							},
							"ifFalseActivities": [
								{
									"name": "fail_historical_file_not_found",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"message": {
											"value": "@concat(\n    'No existe el archivo histórico: year=',\n    pipeline().parameters.year,\n    ', month=',\n    pipeline().parameters.month,\n    ', file=',\n    pipeline().parameters.file_name\n)",
											"type": "Expression"
										},
										"errorCode": "HISTORICAL_FILE_NOT_FOUND"
									}
								}
							],
							"ifTrueActivities": [
								{
									"name": "job_chilecompra_historical",
									"type": "DatabricksJob",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"jobId": "810107194472997",
										"jobParameters": {
											"year": {
												"value": "@pipeline().parameters.year",
												"type": "Expression"
											},
											"month": {
												"value": "@pipeline().parameters.month",
												"type": "Expression"
											},
											"file_name": {
												"value": "@pipeline().parameters.file_name",
												"type": "Expression"
											},
											"run_id": {
												"value": "@pipeline().RunId",
												"type": "Expression"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "ls_databricks_chilecompra",
										"type": "LinkedServiceReference"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"year": {
						"type": "string",
						"defaultValue": "2026"
					},
					"month": {
						"type": "string",
						"defaultValue": "08"
					},
					"file_name": {
						"type": "string",
						"defaultValue": "2026-8.csv"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_oc_historical_csv')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_databricks_chilecompra')]"
			]
		},
